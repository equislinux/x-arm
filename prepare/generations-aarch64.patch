diff --git a/install/helpers/xgen.sh b/install/helpers/xgen.sh
index fb91ddb..0867e56 100755
--- a/install/helpers/xgen.sh
+++ b/install/helpers/xgen.sh
@@ -265,7 +265,8 @@ xgen_capture_kernel() {
     # cached pair ids so the shared ESP copy is recomputed from the new files.
     rm -f "$dest"/*.id
     local found=0
-    for f in "$X_GEN_ROOT"/boot/vmlinuz-* "$X_GEN_ROOT"/boot/initramfs-*.img; do
+    for f in "$X_GEN_ROOT"/boot/vmlinuz-* "$X_GEN_ROOT"/boot/initramfs-*.img \
+             "$X_GEN_ROOT"/boot/Image "$X_GEN_ROOT"/boot/Image.gz; do
         [[ -f "$f" ]] || continue
         cp -a "$f" "$dest/" 2>/dev/null || return 1
         found=1
@@ -273,17 +274,29 @@ xgen_capture_kernel() {
 
     # Per-kernel map for multi-kernel support:
     #   pkgbase <TAB> release <TAB> vmlinuz name <TAB> initramfs name
-    local ts="$dest/kernels.tsv" mdir rel pkgbase vname iname
+    local ts="$dest/kernels.tsv" mdir rel pkgbase vname iname arch_kernel
     : > "$ts"
     if [[ -d "$X_GEN_ROOT/usr/lib/modules" ]]; then
         for mdir in "$X_GEN_ROOT"/usr/lib/modules/*/; do
             [[ -d "$mdir" ]] || continue
             rel="$(basename "$mdir")"
             pkgbase="$(cat "$mdir/pkgbase" 2>/dev/null || true)"
+            arch_kernel=0
+            if [[ -z "$pkgbase" && "$(uname -m)" == "aarch64" ]]; then
+                # Arch Linux ARM kernels ship no pkgbase file; v1 has a
+                # single kernel, linux-aarch64.
+                pkgbase="linux-aarch64"
+                arch_kernel=1
+            fi
             [[ -n "$pkgbase" ]] || continue
             vname=""
             iname=""
             [[ -f "$X_GEN_ROOT/boot/vmlinuz-$pkgbase" ]] && vname="vmlinuz-$pkgbase"
+            if [[ "$arch_kernel" -eq 1 && -z "$vname" ]]; then
+                # ALARM installs /boot/Image(.gz) with no version suffix.
+                [[ -f "$X_GEN_ROOT/boot/Image.gz" ]] && vname="Image.gz"
+                [[ -z "$vname" && -f "$X_GEN_ROOT/boot/Image" ]] && vname="Image"
+            fi
             [[ -f "$X_GEN_ROOT/boot/initramfs-$pkgbase.img" ]] && iname="initramfs-$pkgbase.img"
             [[ -n "$vname" && -n "$iname" ]] || continue
             printf '%s\t%s\t%s\t%s\n' "$pkgbase" "$rel" "$vname" "$iname" >> "$ts"
@@ -304,12 +317,22 @@ xgen_gen_kernels() {
 # Pairs a vmlinuz with its matching initramfs by name suffix
 # (linux -> initramfs-linux.img, linux-lts -> initramfs-linux-lts.img),
 # echoing "kernel|initrd". Used for legacy generations without kernels.tsv.
+# On aarch64 the kernel is /boot/Image(.gz) and the initramfs has no version
+# suffix, so the first initramfs-*.img is paired with it.
 xgen_pick_pair() {
     local dir="$1" k name i
-    k="$(find "$dir" -maxdepth 1 -name 'vmlinuz-*' -type f 2>/dev/null | LC_ALL=C sort | head -1)" || k=""
+    k="$(find "$dir" -maxdepth 1 \
+        \( -name 'vmlinuz-*' -o -name 'Image' -o -name 'Image.gz' \) -type f \
+        2>/dev/null | LC_ALL=C sort | head -1)" || k=""
     [[ -n "$k" ]] || return 0
     name="${k##*/vmlinuz-}"
-    i="$dir/initramfs-$name.img"
+    if [[ "$name" != "${k##*/}" ]]; then
+        i="$dir/initramfs-$name.img"
+    else
+        # aarch64 (/boot/Image, /boot/Image.gz): the initramfs has no
+        # version suffix; pair the kernel with the first initramfs-*.img.
+        i="$(find "$dir" -maxdepth 1 -name 'initramfs-*.img' -type f 2>/dev/null | LC_ALL=C sort | head -1)" || i=""
+    fi
     if [[ ! -f "$i" ]]; then
         i="$(find "$dir" -maxdepth 1 -name 'initramfs-*.img' -type f 2>/dev/null | LC_ALL=C sort | head -1)" || i=""
     fi
@@ -910,7 +933,8 @@ xgen_state_unchanged() {
     cmp -s "$dir/services.txt" "$cur_dir/services.txt" || return 1
     cmp -s "$dir/migrations.txt" "$cur_dir/migrations.txt" || return 1
     [[ "$(xgen_manifest_field "$id" release)" == "$(xgen_kernel_release)" ]] || return 1
-    for f in "$X_GEN_ROOT"/boot/vmlinuz-* "$X_GEN_ROOT"/boot/initramfs-*.img; do
+    for f in "$X_GEN_ROOT"/boot/vmlinuz-* "$X_GEN_ROOT"/boot/initramfs-*.img \
+             "$X_GEN_ROOT"/boot/Image "$X_GEN_ROOT"/boot/Image.gz; do
         [[ -f "$f" ]] || continue
         base="${f##*/}"
         cmp -s "$f" "$cur_dir/boot/$base" || return 1
diff --git a/install/helpers/xkernel.sh b/install/helpers/xkernel.sh
index 8719839..920aab2 100755
--- a/install/helpers/xkernel.sh
+++ b/install/helpers/xkernel.sh
@@ -8,7 +8,12 @@ xkernel_modules_dir() { printf '%s\n' "${X_KERNEL_MODULES_DIR:-/usr/lib/modules}
 xkernel_boot_dir() { printf '%s\n' "${X_KERNEL_BOOT_DIR:-/boot}"; }
 
 xkernel_known() {
-    printf '%s\n' "${X_KERNEL_KNOWN:-linux linux-lts linux-zen linux-hardened linux-rt linux-rt-lts}"
+    if [[ -n "${X_KERNEL_KNOWN:-}" ]]; then
+        printf '%s\n' "$X_KERNEL_KNOWN"
+        return 0
+    fi
+    printf '%s\n' linux linux-lts linux-zen linux-hardened linux-rt linux-rt-lts
+    [[ "$(uname -m)" == "aarch64" ]] && printf '%s\n' linux-aarch64
 }
 
 xkernel_is_known() {
@@ -31,11 +36,24 @@ xkernel_validate() {
     fi
 }
 
+# pkgbase of a modules dir. Arch Linux ARM kernels do not install the
+# pkgbase file; on aarch64 every modules dir is attributed to the single
+# supported kernel, linux-aarch64.
+xkernel_pkgbase_of() {
+    local m="$1" pb
+    [[ -d "$m" ]] || return 0
+    pb="$(cat "$m/pkgbase" 2>/dev/null || true)"
+    if [[ -z "$pb" && "$(uname -m)" == "aarch64" ]]; then
+        pb="linux-aarch64"
+    fi
+    printf '%s\n' "$pb"
+}
+
 xkernel_release_of_pkgbase() {
     local k="$1" m
     for m in "$(xkernel_modules_dir)"/*/; do
         [[ -d "$m" ]] || continue
-        [[ "$(cat "$m/pkgbase" 2>/dev/null)" == "$k" ]] || continue
+        [[ "$(xkernel_pkgbase_of "$m")" == "$k" ]] || continue
         basename "$m"
         return 0
     done
@@ -46,13 +64,14 @@ xkernel_installed_pkgbases() {
     local m
     for m in "$(xkernel_modules_dir)"/*/; do
         [[ -d "$m" ]] || continue
-        cat "$m/pkgbase" 2>/dev/null || true
+        xkernel_pkgbase_of "$m"
     done | LC_ALL=C sort -u
 }
 
 xkernel_running_pkgbase() {
     local rel="${X_KERNEL_RUNNING_RELEASE:-$(uname -r 2>/dev/null || true)}"
-    cat "$(xkernel_modules_dir)/$rel/pkgbase" 2>/dev/null || true
+    [[ -n "$rel" ]] || return 0
+    xkernel_pkgbase_of "$(xkernel_modules_dir)/$rel"
 }
 
 xkernel_pkg_installed() { pacman -Qq "$1" >/dev/null 2>&1; }
